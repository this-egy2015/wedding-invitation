# Dedicated private directory on persistent local disk; never use public/ or a temporary filesystem.
SQLITE_PATH=./data/wedding.sqlite

SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase Auth only; invitation data lives in SQLite on the server.
SUPABASE_ANON_KEY=

# Public base URL, used for magic-link redirects and guest links
SITE_URL=http://localhost:3000

# Public base URL of the R2 bucket (custom domain or r2.dev). All images/audio must live under it.
R2_PUBLIC_URL=https://assets.example.com

# Only needed when seeding a new database; use an existing Supabase Auth user's UUID.
# SEED_OWNER_ID=
# Remote seed only (never NEXT_PUBLIC_). Local seed reads the key from Supabase CLI.
# SUPABASE_SERVICE_ROLE_KEY=
