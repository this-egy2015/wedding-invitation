# Dedicated private directory on persistent local disk; never use public/ or a temporary filesystem.
SQLITE_PATH=./data/wedding.sqlite

SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase Auth + Storage; invitation data lives in SQLite/libSQL.
SUPABASE_ANON_KEY=

# Single administrator email configured privately. Other emails need per-invitation staff access.
ADMIN_EMAIL=

# Public base URL, used for magic-link redirects and guest links
# Required locally; Vercel can infer it from its system deployment domains when unset.
# Custom-domain target after DNS/TLS + Supabase callback are ready: https://invitation.riburupa.com
# Use an HTTP(S) origin only, without a path/query/fragment. See docs/deploy-riburupa.md.
SITE_URL=http://localhost:3000

# Remote SQLite for Vercel. Leave both unset for local development.
# TURSO_DATABASE_URL=libsql://<database>-<organization>.turso.io
# TURSO_AUTH_TOKEN=

# Only needed when seeding a new database; use an existing Supabase Auth user's UUID.
# SEED_OWNER_ID=
# Alternative for a new DB: find/create an unconfirmed Auth user; does not send email.
# SEED_OWNER_EMAIL=
# Required for dashboard music upload and remote seed (never NEXT_PUBLIC_).
# Local dashboard: copy SERVICE_ROLE_KEY from `supabase status -o env` into your private .env.local.
# Local seed reads the key from Supabase CLI. Images use wedding-assets; MP3 uses wedding-music.
# SUPABASE_SERVICE_ROLE_KEY=
