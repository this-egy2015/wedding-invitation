# Dedicated private directory on persistent local disk; never use public/ or a temporary filesystem.
SQLITE_PATH=./data/wedding.sqlite

SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase Auth + Storage; invitation data lives in SQLite/libSQL.
SUPABASE_ANON_KEY=

# Public base URL, used for magic-link redirects and guest links
SITE_URL=http://localhost:3000

# Remote SQLite for Vercel. Leave both unset for local development.
# TURSO_DATABASE_URL=libsql://<database>-<organization>.turso.io
# TURSO_AUTH_TOKEN=

# Only needed when seeding a new database; use an existing Supabase Auth user's UUID.
# SEED_OWNER_ID=
# Remote seed only: Auth owner verification and Storage upload (never NEXT_PUBLIC_).
# Local seed reads the key from Supabase CLI. Media lives under wedding-assets/berubah/<slug>.
# SUPABASE_SERVICE_ROLE_KEY=
