# Supabase transaction pooler (port 6543) for the app runtime
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) for drizzle-kit migrations
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
# Anon / publishable key. Only used server-side; tables have RLS enabled with no policies.
SUPABASE_ANON_KEY=

# Public base URL, used for magic-link redirects and guest links
SITE_URL=http://localhost:3000

# Public base URL of the R2 bucket (custom domain or r2.dev). All images/audio must live under it.
R2_PUBLIC_URL=https://assets.example.com
